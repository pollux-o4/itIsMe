---
import { ClientRouter } from 'astro:transitions';
import { site, url, asset } from '../lib/content';
import { portfolio } from '../lib/portfolio';
import '../styles/global.css';
import '../styles/story.css';
import displayFont from '../assets/fonts/pretendard-variable.woff2?url';
import { Printer, Mail } from 'lucide-react';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{site.title}</title><meta name="description" content={site.description}/><meta name="theme-color" content="#f5f6f9"/>
  <link rel="icon" href={asset('/images/favicon.svg')}/><link rel="canonical" href={new URL(url(),Astro.site)}/>
  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin/>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"ProfilePage",mainEntity:{"@type":"Person",name:portfolio.name,jobTitle:portfolio.role,description:site.description,url:new URL(url(),Astro.site).href,sameAs:[site.github],alumniOf:{"@type":"CollegeOrUniversity",name:"건양대학교"},knowsAbout:["Python","Machine learning","Computer vision","Next.js","FastAPI","Clinical data monitoring","Data quality assurance"]}}).replace(/</g,'\\u003c')}/>
  <ClientRouter/>
</head>
<body class="story-body">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="story-header">
    <a class="story-brand" href="#start" aria-label={`${portfolio.name} 포트폴리오 처음으로`}><span aria-hidden="true">j.</span> {portfolio.name} <small>{portfolio.role}</small></a>
    <div class="header-actions"><a href="#contact"><Mail size={15} aria-hidden="true"/> 연락</a><button class="print-action" type="button" data-print><Printer size={15} aria-hidden="true"/> 전체 인쇄</button></div>
  </header>
  <nav class="story-nav" aria-label="포트폴리오 바로가기">
    <a href="#start" aria-current="location"><span>00</span> 소개</a>
    <a href="#agriculture"><span>01</span> 농산물 가격</a>
    <a href="#engine"><span>02</span> 엔진 수명</a>
    <a href="#nutrition"><span>03</span> 음식 분석 앱</a>
    <a href="#archive"><span>04</span> 다른 프로젝트</a>
    <a href="#background"><span>05</span> 경력·학력</a>
  </nav>
  <main id="main" class="story-main" tabindex="-1"><slot/></main>
  <footer class="story-footer" id="contact">
    <span class="kicker">연락처</span><h2>이메일로<br/>연락해 주세요.</h2>
    <div><a href={`mailto:${portfolio.email}`}>{portfolio.email} ↗</a><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗ <span class="sr-only">새 창</span></a></div>
  </footer>
  <script src="../scripts/story.ts"></script>
</body>
</html>
