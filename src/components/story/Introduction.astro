---
import { ArrowDown, ArrowRight } from 'lucide-react';
import { portfolio } from '../../lib/portfolio';
import PortfolioImage from '../PortfolioImage.astro';
import Emphasis from '../Emphasis.astro';
const lines = portfolio.headline.split('\n');
const [first] = portfolio.projects;
---
<section id="start" class="hero" data-chapter aria-labelledby="intro-title">
  <div class="shell">
    <div class="hero-meta">
      <span>Portfolio <i>2025—26</i></span>
      <span>{portfolio.role}</span>
      <span>자료 기준 {portfolio.sourceDate}</span>
    </div>
    <div class="hero-grid">
      {/* Keep the full-resolution portrait in the original PDF's display orientation. */}
      <figure class="hero-portrait">
        <PortfolioImage name="portrait" width={362} alt={`${portfolio.name} 프로필 사진`} sizes="(max-width: 760px) 30vw, (max-width: 1480px) 32vw, 440px" priority/>
        <figcaption><span>Fig. 00</span>{portfolio.name}, {portfolio.english}</figcaption>
      </figure>
      <div class="hero-words">
        <p class="hero-motto">{portfolio.motto}</p>
        <h1 id="intro-title" class="hero-title">
          {lines.map((line, i) => <span class="line" style={`--line:${i}`}><span class={i === 1 ? 'mark' : undefined}>{line}</span></span>)}
        </h1>
        <div class="hero-about">
          <p class="about-lead">{portfolio.about.lead}</p>
          <p class="about-thesis"><Emphasis text={portfolio.about.thesis}/></p>
          <p class="about-motivation">{portfolio.about.motivation}</p>
        </div>
        <dl class="hero-stats">
          {portfolio.highlights.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      </div>
    </div>
    <a class="hero-scroll" href="#work"><ArrowDown size={18} aria-hidden="true"/>세 가지 질문으로 보기</a>
  </div>
</section>

<section id="work" class="index" data-chapter aria-labelledby="work-title">
  <div class="shell">
    <div class="section-head">
      <p class="label">Index — 대표 사례 3</p>
      <h2 id="work-title">궁금해하실<br/>세 가지 질문에 답합니다.</h2>
    </div>
    <div class="index-body">
      <ol class="question-list" role="list">
        {portfolio.projects.map((project, i) => (
          <li>
            <a class="question" href={`#${project.id}`} data-preview-target={project.id}>
              <span class="question-no">Q{i + 1}</span>
              <span class="question-label">{project.question.label}?</span>
              <span class="question-evidence"><Emphasis text={project.question.evidence}/></span>
              <span class="question-case">
                <span>Case {project.number} · {project.cardTitle}</span>
                <small>내 역할 · {project.cardRole}</small>
              </span>
              <PortfolioImage class="question-thumb" name={project.cover} width={320} alt="" sizes="(max-width: 1099px) 320px, 1px"/>
              <span class="question-go" aria-hidden="true"><ArrowRight size={22}/></span>
            </a>
          </li>
        ))}
      </ol>
      {/* A fixed slot, never a floating image over text (SPEC 2.6). */}
      <div class="preview-slot" aria-hidden="true">
        {portfolio.projects.map(project => (
          <figure class="preview-panel" data-preview={project.id} data-active={project.id === first.id ? '' : undefined}>
            <div class="preview-frame"><PortfolioImage name={project.cover} width={640} alt="" sizes="(max-width: 1099px) 1px, 30vw"/></div>
            <figcaption><span>Case {project.number}</span>{project.cardTitle} · {project.team}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
