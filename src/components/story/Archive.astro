---
import { Plus } from 'lucide-react';
import { portfolio } from '../../lib/portfolio';
import PortfolioImage from '../PortfolioImage.astro';
import Emphasis from '../Emphasis.astro';

const groups = portfolio.otherProjectCategories.map(category => ({
  ...category,
  projects: portfolio.otherProjects.filter(project => project.category === category.id),
}));
// Numbers follow reading order across the groups.
let number = 0;
const total = portfolio.otherProjects.length;
---
<section id="archive" class="archive" data-chapter aria-labelledby="archive-title">
  <div class="shell">
    <div class="section-head">
      <p class="label">그 밖의 작업 {String(total).padStart(2, '0')}</p>
      <h2 id="archive-title">직접 운영하는 앱부터 비전·분석까지<br/>범위를 넓힌 작업들.</h2>
    </div>
    <div class="archive-list">
      <div class="archive-columns" aria-hidden="true"><span>No.</span><span></span><span>프로젝트</span><span>유형</span><span>기간 · 형태</span><span>주요 기술</span></div>
      {groups.map(group => <section class="archive-group" aria-labelledby={`archive-${group.id}`}>
          <h3 class="archive-group-head" id={`archive-${group.id}`}>{group.label} <span>{group.summary}</span></h3>
          {group.projects.map(project => <details class="work-row" data-disclosure id={project.id}>
            <summary>
              <span class="work-no">{String(++number).padStart(2, '0')}</span>
              <PortfolioImage class="work-thumb" name={project.image} width={600} alt="" sizes="80px"/>
              <span class="work-name">
                <strong class="work-title">{project.title}</strong>
                <span class="work-highlight">{project.highlight}</span>
              </span>
              <span class="work-meta">
                <span class="work-type">{project.type}</span><span class="work-duration">{project.duration}</span>
              </span>
              <span class="work-stack">{project.stack}</span>
              <span class="disclosure-sign" aria-hidden="true"><Plus size={20}/></span>
            </summary>
            <div class="disclosure-content work-body">
              <PortfolioImage name={project.image} width={600} alt={project.imageAlt} sizes="(max-width: 760px) 90vw, 400px"/>
              <div>
                <p><Emphasis text={project.description}/></p>
                <small class="source-label">{project.duration.includes('개인') ? '개인 프로젝트' : '팀 프로젝트'}</small>
                {project.presentation && <a class="pill" href={`https://drive.google.com/file/d/${project.presentation}/view`} target="_blank" rel="noreferrer">
                  발표자료 ↗<span class="sr-only"> 새 창</span>
                </a>}
                {project.links?.map(link => <a class="pill" href={link.href} target="_blank" rel="noreferrer">
                  {link.label} ↗<span class="sr-only"> 새 창</span>
                </a>)}
              </div>
            </div>
          </details>)}
      </section>)}
    </div>
  </div>
</section>
