---
import { Plus } from 'lucide-react';
import { portfolio } from '../../lib/portfolio';
import { portfolioImage as img } from '../../lib/content';
import Emphasis from '../Emphasis.astro';
---
<section id="archive" class="archive" data-chapter aria-labelledby="archive-title">
  <div class="shell">
    <div class="section-head">
      <p class="label">Archive — 그 밖의 작업 {String(portfolio.otherProjects.length).padStart(2, '0')}</p>
      <h2 id="archive-title">수집, 분석, 비전까지<br/>범위를 넓힌 작업들.</h2>
    </div>
    <div class="archive-list">
      <div class="archive-columns" aria-hidden="true"><span>No.</span><span></span><span>프로젝트</span><span>분야</span><span>기간 · 형태</span><span>주요 기술</span></div>
      {portfolio.otherProjects.map((project, i) => <details class="work-row" data-disclosure id={project.id}>
        <summary>
          <span class="work-no">{String(i + 1).padStart(2, '0')}</span>
          <img class="work-thumb" src={img(project.image)} width="600" height="360" alt="" loading="lazy" decoding="async"/>
          <strong class="work-title">{project.title}</strong>
          <span class="work-type">{project.type}</span>
          <span class="work-duration">{project.duration}</span>
          <span class="work-stack">{project.stack}</span>
          <span class="disclosure-sign" aria-hidden="true"><Plus size={20}/></span>
        </summary>
        <div class="disclosure-content work-body">
          <img src={img(project.image)} width="600" height="360" alt={project.imageAlt} loading="eager" decoding="async"/>
          <div>
            <p><Emphasis text={project.description}/></p>
            <small class="source-label">{project.duration.includes('개인') ? '개인 프로젝트' : '팀 프로젝트'} · 원본 p.{project.source}</small>
            {project.presentation && <a class="pill" href={`https://drive.google.com/file/d/${project.presentation}/view`} target="_blank" rel="noreferrer">
              발표자료 ↗<span class="sr-only"> 새 창</span>
            </a>}
          </div>
        </div>
      </details>)}
    </div>
  </div>
</section>
