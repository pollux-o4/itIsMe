---
import { portfolio } from '../../lib/portfolio';
import { groupByYear, kindLabel, projectCount, spanMonths } from '../../lib/timeline';
import StorySection from './parts/StorySection.astro';

const { timeline, timelineYears, sourceDate } = portfolio;
const latest = timelineYears.at(-1)?.year;
const years = groupByYear(timeline, timelineYears);
---
<StorySection id="timeline" class="timeline" label={`연표 · ${timeline[0]?.date} → ${sourceDate}`}>
  <Fragment slot="title">{spanMonths(timeline, sourceDate)}개월 동안,<br/>프로젝트 {projectCount(timeline)}개.</Fragment>
  <div class="timeline-key" aria-hidden="true">
    {Object.entries(kindLabel).map(([kind, label]) => <span class={`kind-${kind}`}>{label}</span>)}
  </div>
  {years.map(year => (
    <section class={`timeline-year${year.year === latest ? ' is-current' : ''}`} aria-labelledby={`year-${year.year}`}>
      <header class="year-head">
        <h3 id={`year-${year.year}`}>{year.year}</h3>
        <p>{year.note}</p>
      </header>
      <ol class="timeline-list" role="list">
        {year.entries.map(entry => <li>
          <time>{entry.date.slice(5)}<small>월</small></time>
          <ul role="list">{entry.items.map(item => <li class={`kind-${item.kind}`}>
            <span class="sr-only">{kindLabel[item.kind]}: </span>{item.text}
          </li>)}</ul>
        </li>)}
      </ol>
    </section>
  ))}
</StorySection>
