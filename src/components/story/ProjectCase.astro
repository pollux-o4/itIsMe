---
import { Plus } from 'lucide-react';
import type { Project } from '../../lib/portfolio-schema';
import { portfolio } from '../../lib/portfolio';
import Emphasis from '../Emphasis.astro';
import Exhibit from '../Exhibit.astro';
import ValidationFlow from '../ValidationFlow.astro';

interface Props { project: Project }
const { project: p } = Astro.props;
// Interactive visuals that can stand in for a figure; each still answers one claim.
const visuals = { split: ValidationFlow };
const story = [
  ['문제', p.narrative.problem],
  ['판단', p.narrative.decision],
  ['실행', p.narrative.action],
  ['결과', p.narrative.verification],
  ['다음에 한다면', p.narrative.limits],
] as const;
---
<section id={p.id} class={`case case-${p.kind}${p.kind === 'service' ? ' is-night' : ''}`} data-chapter aria-labelledby={`${p.id}-title`}>
  <div class="shell">
    <header class="case-head">
      <p class="case-index"><span>Case</span> <b>{p.number}</b> <span>/ 0{portfolio.projects.length}</span></p>
      <p class="case-question">{p.question.label}?</p>
      <a class="case-source" href={p.link} target="_blank" rel="noreferrer">발표자료 ↗<span class="sr-only"> 새 창, {p.cardTitle}</span></a>
      <h2 id={`${p.id}-title`} class="case-title" data-reveal>
        {p.headline.split('\n').map(line => <span class="line"><span>{line}</span></span>)}
      </h2>
      <p class="case-name">{p.title.replaceAll('\n', ' ')}<span>{p.period} · {p.team}</span></p>
    </header>

    {/* Thirty seconds: role, what was done, what came of it (SPEC 4.4). */}
    <dl class="case-brief">
      <div><dt>내 역할</dt><dd><Emphasis text={p.role}/></dd></div>
      <div><dt>한 일</dt><dd><Emphasis text={p.summary}/></dd></div>
      <div class="brief-result"><dt>{p.outcomeLabel}</dt><dd><Emphasis text={p.outcome}/><small>{p.outcomeNote}</small></dd></div>
    </dl>
    <div class="case-tags" aria-label="주요 기술">{p.tags.map(tag => <span>{tag}</span>)}</div>

    {/* Each picture sits beside the sentence it proves, with numbered marks (SPEC 2.11). */}
    <ol class="evidence-list" role="list">
      {p.evidence.map((item, i) => {
        const Visual = item.visual ? visuals[item.visual] : undefined;
        const label = `증거 ${String(i + 1).padStart(2, '0')}`;
        return (
          <li class="evidence">
            <div class="evidence-claim">
              <span class="evidence-no">{label}</span>
              <h3><Emphasis text={item.claim}/></h3>
              <p>{item.why}</p>
            </div>
            <div class="evidence-picture">
              {Visual ? <Visual/> : item.figure && <Exhibit figure={item.figure} label={label}/>}
            </div>
          </li>
        );
      })}
    </ol>

    <div class="case-share">
      <div class="share-mine">
        <h3>내가 맡은 일</h3>
        <ul>{p.contribution.mine.map(item => <li>{item}</li>)}</ul>
      </div>
      <div class="share-team">
        <h3>팀이 함께한 일</h3>
        <ul>{p.contribution.team.map(item => <li>{item}</li>)}</ul>
      </div>
    </div>

    <details class="case-disclosure" id={`${p.id}-evidence`} data-disclosure>
      <summary>
        <span class="label">면접 전에 · 원본 p.{p.source}</span>
        <strong>과정 전체 읽기</strong>
        <span class="disclosure-sign" aria-hidden="true"><Plus size={22}/></span>
      </summary>
      <div class="disclosure-content">
        <ol class="case-story" role="list">
          {story.map(([label, text], i) => (
            <li class={i === story.length - 1 ? 'is-next' : undefined}>
              <span class="story-no">0{i + 1}</span>
              <h3>{label}</h3>
              <p><Emphasis text={text}/></p>
            </li>
          ))}
        </ol>
        <dl class="facts">{p.facts.map(fact => <div><dd>{fact.value}</dd><dt>{fact.label}</dt></div>)}</dl>
        <div class="detail-text">
          {p.details.map(detail => <div>
            <h3>{detail.heading}</h3>
            {detail.text.split('\n').map(paragraph => <p><Emphasis text={paragraph}/></p>)}
          </div>)}
        </div>
        <div class="case-links">
          {p.resources.map(resource => <a class="pill" href={resource.href} target="_blank" rel="noreferrer">
            {resource.label} ↗<span class="sr-only"> 새 창</span>
          </a>)}
          <a class="pill" href={p.link} target="_blank" rel="noreferrer">발표자료 전체 ↗<span class="sr-only"> 새 창</span></a>
        </div>
      </div>
    </details>
  </div>
</section>
