---
import { Plus } from 'lucide-react';
import { portfolio } from '../../lib/portfolio';
import Emphasis from '../Emphasis.astro';
---
<section id="background" class="background" data-chapter aria-labelledby="background-title">
  <div class="shell">
    <div class="section-head">
      <p class="label">Profile — 이력 · 자료 기준 {portfolio.sourceDate}</p>
      <h2 id="background-title">데이터를 다루는 일은<br/>개발 전부터 해 왔습니다.</h2>
    </div>
    <div class="profile-grid">
      <div class="profile-col">
        <h3 class="label">경력</h3>
        {portfolio.experience.map(experience => <article class="profile-item">
          <time>{experience.period}</time>
          <h4>{experience.role}</h4>
          <span class="profile-org">{experience.organization}</span>
          <p><Emphasis text={experience.summary}/></p>
        </article>)}
      </div>
      <div class="profile-col">
        <h3 class="label">학력 · 교육</h3>
        {portfolio.education.map(education => <article class="profile-item">
          <time>{education.period}</time>
          <h4>{education.title}</h4>
          <p>{education.description}</p>
        </article>)}
      </div>
      <div class="profile-col">
        <h3 class="label">자격</h3>
        <ul class="cert-list" role="list">
          {portfolio.certifications.map(certification => <li><span>{certification.name}</span><time>{certification.date}</time></li>)}
        </ul>
      </div>
    </div>
    <details class="profile-detail" data-disclosure>
      <summary>
        <strong>경력 상세 · 해커톤 · 진행 중인 작업</strong>
        <span class="disclosure-sign" aria-hidden="true"><Plus size={22}/></span>
      </summary>
      <div class="disclosure-content">
        <div class="experience-details">
          {portfolio.experience.map(experience => <div>
            <h3>{experience.organization} · {experience.role}</h3>
            <p><Emphasis text={experience.details}/></p><small>{experience.source}</small>
          </div>)}
        </div>
        <ul class="additional-list" role="list">
          {portfolio.additional.map(project => <li><time>{project.date}</time><span>{project.title}<small>{project.note}</small></span></li>)}
        </ul>
        <p class="record-note">{portfolio.recordNote}</p>
      </div>
    </details>
  </div>
</section>
