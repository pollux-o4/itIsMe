---
import { portfolio } from '../../lib/portfolio';
import StorySection from './parts/StorySection.astro';
import ProfileItem from './parts/ProfileItem.astro';
---
<StorySection id="background" class="background" label="이력">
  <Fragment slot="title">데이터를 다루는 일은<br/>개발 전부터 해 왔습니다.</Fragment>
  <div class="profile-grid">
    <div class="profile-col">
      <h3 class="label">경력</h3>
      {portfolio.experience.map(item => <ProfileItem period={item.period} title={item.role} note={item.organization} noteClass="profile-org"/>)}
    </div>
    <div class="profile-col">
      <h3 class="label">교육</h3>
      {portfolio.training.map(item => <ProfileItem period={item.period} title={item.title} note={item.description}/>)}
      <h3 class="label profile-subhead">학력</h3>
      {portfolio.education.map(item => <ProfileItem period={item.period} title={item.title} note={item.description}/>)}
    </div>
    <div class="profile-col">
      <h3 class="label">자격</h3>
      <ul class="cert-list" role="list">
        {portfolio.certifications.map(certification => <li><span>{certification.name}</span><time>{certification.date}</time></li>)}
      </ul>
    </div>
  </div>
</StorySection>
