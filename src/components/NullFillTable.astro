---
// Rows from the deck's before/after table (p.19): fat and carbs were empty, so energy came out low.
const rows = [
  { name: '슈퍼콤비네이션 피자 (L)', kcal: 262 },
  { name: '슈퍼하와이안 피자 (L)', kcal: 246 },
  { name: '스위트가든 피자 (L)', kcal: 231 },
  { name: '스위티고구밍 피자 (L)', kcal: 186 },
];
const median = { fat: '12', carbs: '30.575' };
---
<figure class="null-fill">
  <p class="null-fill-symptom"><span class="label">증상</span><span>마르게리타 피자 한 조각</span><s>44 kcal</s></p>
  <table>
    <caption class="sr-only">피자 영양 성분표. 지방과 탄수화물이 비어 있던 칸을 같은 식품군 중앙값으로 채웠습니다.</caption>
    <thead>
      <tr><th scope="col">식품명</th><th scope="col">에너지(kcal)</th><th scope="col">지방(g)</th><th scope="col">탄수화물(g)</th></tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          <th scope="row">{row.name}</th>
          <td>{row.kcal}</td>
          <td><span class="was" aria-label="비어 있던 칸">—</span><b>{median.fat}</b></td>
          <td><span class="was" aria-label="비어 있던 칸">—</span><b>{median.carbs}</b></td>
        </tr>
      ))}
    </tbody>
  </table>
  <figcaption>빈 영양소 값을 같은 식품군 중앙값으로 채운 전후 <span class="source-label">발표자료 p.19</span></figcaption>
</figure>
