---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageWidths, imageQuality } from '../lib/image-widths';

interface Props {
  name: string;
  alt: string;
  class?: string;
  width?: number;
  sizes?: string;
  priority?: boolean;
  /** CSS px of a square slot: the image is cropped to a square on the server at 1x–3x, so wide sources never upscale. */
  square?: number;
}
const { name, alt, class: className, width, sizes, priority = false, square } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../../public/images/portfolio/*.webp', { eager: true });
const original = sources[`../../public/images/portfolio/${name}.webp`]?.default;
// Preserve the intentional waist crop without enlarging the old thumbnail.
const source = name === 'portrait' ? sources['../../public/images/portfolio/portrait-framed.webp']?.default : original;
if (!source) throw new Error(`Missing portfolio image: ${name}`);
const widths = imageWidths(source.width);
---
{square ? <Image src={source} alt={alt} class={className} width={square} height={square} fit="cover" position="center"
  densities={[1, 2, 3].filter(density => density === 1 || density * square <= Math.min(source.width, source.height))} quality={imageQuality(name)}
  loading="lazy" decoding="async" data-print-src={source.src}/> :
<Image src={source} alt={alt} class={className} widths={widths} sizes={sizes!}
  width={width ?? source.width} quality={imageQuality(name)}
  loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'}
  data-print-src={source.src}/>}
