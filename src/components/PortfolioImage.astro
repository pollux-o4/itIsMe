---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { portfolioImage } from '../lib/content';

interface Props {
  name: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  sizes: string;
  priority?: boolean;
}
const { name, alt, class: className, width, height, sizes, priority = false } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../../public/images/portfolio/*.webp', { eager: true });
const source = sources[`../../public/images/portfolio/${name}.webp`]?.default;
if (!source) throw new Error(`Missing portfolio image: ${name}`);
const widths = [...new Set([160, 320, 640, 960, 1280, source.width].filter(value => value <= source.width))];
---
<Image src={source} alt={alt} class={className} widths={widths} sizes={sizes}
  width={width ?? source.width} height={height ?? source.height} fit="inside" quality={85}
  loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'}
  data-print-src={portfolioImage(name)}/>
