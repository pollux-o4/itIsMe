---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  class?: string;
  width?: number;
  sizes: string;
  priority?: boolean;
}
const { name, alt, class: className, width, sizes, priority = false } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('../../public/images/portfolio/*.webp', { eager: true });
const original = sources[`../../public/images/portfolio/${name}.webp`]?.default;
// Preserve the intentional waist crop without enlarging the old thumbnail.
const source = name === 'portrait' ? sources['../../public/images/portfolio/portrait-framed.webp']?.default : original;
if (!source) throw new Error(`Missing portfolio image: ${name}`);
const widths = [...new Set([160, 320, 640, 960, 1280, source.width].filter(value => value <= source.width))];
---
<Image src={source} alt={alt} class={className} widths={widths} sizes={sizes}
  width={width ?? source.width} quality={name === 'portrait' ? 100 : 85}
  loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'}
  data-print-src={source.src}/>
