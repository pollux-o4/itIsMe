---
import StoryLayout from '../layouts/StoryLayout.astro';
import Introduction from '../components/story/Introduction.astro';
import ProjectCase from '../components/story/ProjectCase.astro';
import Archive from '../components/story/Archive.astro';
import Background from '../components/story/Background.astro';
import { portfolio } from '../lib/portfolio';
---
<StoryLayout>
  <Introduction/>
  {portfolio.projects.map(project => <ProjectCase project={project}/>)}
  <Archive/>
  <Background/>
</StoryLayout>
