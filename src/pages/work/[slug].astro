---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { publicProjects, url, asset } from "../../lib/content";
export async function getStaticPaths() {
  return (await publicProjects()).map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const all = await publicProjects();
const next =
  all[(all.findIndex((item) => item.id === project.id) + 1) % all.length];
---

<Layout title={p.title} description={p.summary} active="work">
  <article class="detail wrap">
    <a href={url("work/")} class="text-link back-link">← 모든 작업</a><div
      class="detail-heading"
    >
      <span class="eyebrow">{p.category} / {p.year}</span><h1>{p.title}</h1><p>
        {p.summary}
      </p>{
        p.sample && (
          <span class="sample-badge">예시 프로젝트 · 디자인 검토용</span>
        )
      }
    </div>
    <figure class="detail-art" style={`view-transition-name:art-${p.slug}`}>
      <img
        src={asset(p.image)}
        alt={p.imageAlt}
        width="1200"
        height="900"
        fetchpriority="high"
      />
    </figure>
    <div class="detail-overview">
      <aside>
        <span class="eyebrow">AT A GLANCE</span><dl>
          <dt>ROLE</dt><dd>{p.role}</dd><dt>TOOLS & IDEAS</dt><dd>
            {p.tags.join(" · ")}
          </dd><dt>STATUS</dt><dd>
            {p.sample ? "예시 · 컨셉 스터디" : "공개 프로젝트"}
          </dd>
        </dl>{
          p.github && (
            <a
              class="text-link"
              href={p.github}
              target="_blank"
              rel="noreferrer"
            >
              GitHub ↗<span class="sr-only"> (새 창)</span>
            </a>
          )
        }{
          p.demo && (
            <a class="text-link" href={p.demo} target="_blank" rel="noreferrer">
              Live demo ↗<span class="sr-only"> (새 창)</span>
            </a>
          )
        }
      </aside><div class="detail-story">
        <section>
          <span class="eyebrow">01 / THE QUESTION</span><h2>
            어떤 문제에서 시작했나.
          </h2><p>{p.problem}</p>
        </section><section>
          <span class="eyebrow">02 / THE APPROACH</span><h2>
            어떻게 풀어볼 수 있을까.
          </h2><p>{p.approach}</p>
        </section><section>
          <span class="eyebrow">03 / THE OUTCOME</span><h2>
            지금 확인할 수 있는 것.
          </h2><p>{p.outcome}</p>
        </section><details class="deep-dive">
          <summary
            ><span
              ><span class="eyebrow">DEEP DIVE</span>설계 과정과 기술적 기록</span
            ><span class="disclosure-plus" aria-hidden="true">+</span></summary
          ><div class="prose"><Content /></div>
        </details>
      </div>
    </div>
    {
      p.gallery.length > 0 && (
        <section class="gallery" aria-label="프로젝트 갤러리">
          {p.gallery.map((item) => (
            <figure>
              <img
                src={asset(item.image)}
                alt={item.caption}
                width="1200"
                height="900"
                loading="lazy"
              />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </section>
      )
    }
    {
      all.length > 1 && (
        <a href={url(`work/${next.data.slug}/`)} class="next-project">
          <span class="eyebrow">NEXT EXPLORATION</span>
          <span>
            {next.data.title} <span aria-hidden="true">↗</span>
          </span>
        </a>
      )
    }
  </article>
</Layout>
